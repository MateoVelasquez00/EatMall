<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="EatMall.Vista.Admin" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>EatMall Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <style>
        :root {
            --color-rol: #006948;
            --color-rol-light: #adedd3;
            --color-rol-text: #00513700;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: #f8f9ff;
            color: #0b1c30;
            overflow: hidden;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            font-size: 20px;
            line-height: 1;
        }

        /* ── LAYOUT ── */
        .admin-wrapper {
            display: flex;
            height: 100vh;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 280px;
            min-width: 280px;
            background: white;
            border-right: 1px solid #bccac0;
            display: flex;
            flex-direction: column;
            padding: 16px;
            gap: 8px;
            overflow-y: auto;
        }

        .sidebar-brand {
            padding: 8px;
            margin-bottom: 16px;
        }

            .sidebar-brand h1 {
                font-size: 20px;
                font-weight: 700;
                color: var(--color-rol);
                line-height: 28px;
            }

            .sidebar-brand p {
                font-size: 12px;
                color: #3d4a42;
                font-weight: 500;
            }

        /* Links del menú */
        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            color: #3d4a42;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .menu-link:hover {
                background: #eff4ff;
                color: var(--color-rol);
                text-decoration: none;
            }

                .menu-link:hover .material-symbols-outlined {
                    color: var(--color-rol);
                }

            .menu-link.active {
                background: var(--color-rol-light);
                color: #0b513d;
                font-weight: 700;
                box-shadow: 0 2px 4px rgba(0,105,72,0.1);
            }

                .menu-link.active .material-symbols-outlined {
                    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                    color: var(--color-rol);
                }

        .menu-hijo {
            padding-left: 44px;
            font-size: 13px;
        }

        /* ── FOOTER SIDEBAR ── */
        .sidebar-footer {
            margin-top: auto;
            padding: 16px;
            background: #eff4ff;
            border-radius: 12px;
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--color-rol);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 14px;
            flex-shrink: 0;
        }

        .sidebar-user-info {
            flex: 1;
            overflow: hidden;
        }

        .sidebar-user-name {
            font-size: 13px;
            font-weight: 600;
            color: #0b1c30;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-user-role {
            font-size: 10px;
            color: #3d4a42;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 500;
        }

        .btn-cerrar {
            background: none;
            border: none;
            color: #3d4a42;
            cursor: pointer;
            padding: 6px;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .btn-cerrar:hover {
                background: rgba(0,105,72,0.1);
                color: var(--color-rol);
            }

        /* ── CONTENIDO ── */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding: 32px;
            background: #f8f9ff;
        }
    </style>

    <asp:ContentPlaceHolder ID="head2" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />

        <div class="admin-wrapper">

            <!-- SIDEBAR -->
            <aside class="sidebar">

                <!-- Brand -->
                <div class="sidebar-brand">
                    <h1>EatMall Admin</h1>
                </div>

                <!-- Menú dinámico -->
                <nav id="MenuRol" runat="server"></nav>

                <!-- Footer usuario -->
                <div class="sidebar-footer">
                    <div class="sidebar-user">
                        <div class="sidebar-user-avatar" id="avatarInicial" runat="server">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name">
                                <asp:Label ID="lblUsuario" runat="server" Text="Usuario" />
                            </div>
                            <div class="sidebar-user-role" id="lblRolSidebar" runat="server">
                                Admin
                            </div>
                        </div>
                        <asp:LinkButton ID="lbCerrar" runat="server"
                            CssClass="btn-cerrar"
                            OnClick="lbCerrar_Click"
                            title="Cerrar sesión">
                            <span class="material-symbols-outlined">logout</span>
                        </asp:LinkButton>
                    </div>
                </div>

            </aside>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="main-content">
                <asp:ContentPlaceHolder ID="ContentBody" runat="server">
                </asp:ContentPlaceHolder>
            </main>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    </form>
</body>
</html>